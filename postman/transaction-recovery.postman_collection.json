{
  "info": {
    "name": "4.3 Transaction Recovery Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Transactional Outbox and Saga educational flow"
  },
  "item": [
    {
      "name": "01. 정상 처리",
      "item": [
        {
          "name": "01. 신청 생성",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transaction-demo/applications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transaction-demo",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"planCode\": \"BASIC\", \"scenario\": \"SUCCESS\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created',()=>pm.response.to.have.status(201));",
                  "const r=pm.response.json(); pm.environment.set('application_id',r.applicationId); pm.environment.set('saga_id',r.sagaId); pm.environment.set('event_id',r.eventId);"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Outbox 발행",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transaction-demo/outbox/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transaction-demo",
                "outbox",
                "publish"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('one published',()=>pm.expect(pm.response.json().published).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "03. 이벤트 소비",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transaction-demo/events/consume",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transaction-demo",
                "events",
                "consume"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('one consumed',()=>pm.expect(pm.response.json().consumed).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "04. Saga 조회",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transaction-demo/sagas/{{saga_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transaction-demo",
                "sagas",
                "{{saga_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('COMPLETED',()=>pm.expect(pm.response.json().status).to.eql('COMPLETED'));"
                ]
              }
            }
          ]
        }
      ]
    },
